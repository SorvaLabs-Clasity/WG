{
  "name": "github-control-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Internal GitHub Control Hub — manage repos, branches, and protections via a web UI",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "demo": "concurrently \"npm run dev:backend\" \"cross-env VITE_DEMO_MODE=true npm run dev:frontend\"",
    "demo:no-login": "cross-env VITE_DEMO_MODE=true npm run dev:frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1111.0",
    "@aws-sdk/client-sns": "^3.1110.0",
    "@aws-sdk/client-sts": "^3.1111.0"
  }
}

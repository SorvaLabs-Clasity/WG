
# Private keys — never commit
*.pem
*.key

# CDK build output — regenerated by `cdk synth`
cdk.out/
.claude/worktrees/

# CDK caches account-specific lookups (VPC/subnet ids) here. Committing it
# carries one account's topology into every clone; CDK re-looks-up when absent.
github-control-hub/infra/cdk.context.json

# Vite layers env files: .env.<mode> holds app defaults and is committed,
# .env.<mode>.local is the per-install layer and is not. The migration script
# writes the .local one (company name, region), which must not travel with a
# clone into another organization.
.env.local
.env.*.local
github-control-hub/frontend/.env

# Local Claude Code permissions — contains machine paths
.claude/settings.local.json

# TypeScript incremental build state. A build artifact, regenerated on every
# `tsc`, and it was tracked — so it churned into every commit it touched and
# carried nothing a reader could use.
*.tsbuildinfo
